# Fun Language AI Ontology
#
# This is the source of truth. `ontology/tools/build.fun` validates it and
# projects it into model-facing artifacts (JSON, JSON-LD, llms.txt, cards).
# Every concept should carry at least one runnable example; `build.fun --check`
# executes them.

meta
  name Fun Language AI Ontology
  version 0.1.0
  funVersion 9.5.7
  license MIT
  updated 2026-11-24
  repository https://github.com/funlang/fun
  description A versioned, executable knowledge graph for writing Fun, aimed at AI agents. Each concept is a stable id, a short card, cross-language anchors, and runnable evidence.

concepts
  # ---------------------------------------------------------------------------
  # Level 0: the irreducible language surface
  # ---------------------------------------------------------------------------
  -
    id syntax.hello
    type construct
    name Hello world
    summary A Fun script is a sequence of statements; `?.` prints a value and a newline.
    level 0
    tags
      - core
      - syntax
    card `?. 'Hello, Fun!';`
    intent
      - print a value
      - hello world
      - 打印
      - 输出
    from
      js `console.log('Hello')`
      py `print('Hello')`
      c `puts("Hello");`
    relations
      partOf
        - syntax.statement
      seeAlso
        - syntax.print
    examples
      -
        code `?. 'Hello, Fun!';
`
        expect `Hello, Fun!
`

  -
    id syntax.statement
    type construct
    name Statements and semicolons
    summary Statements end with `;`. The `;` after a block closer (`end if`, `end fun`, `end class`, `end do`, `end loop`, `end try`) is optional. Newlines are not statement boundaries.
    level 0
    tags
      - core
      - syntax
    card `stmt; block ... end block`
    intent
      - statement
      - semicolon
      - 分号
      - 语句
    from
      js `statement;`
      py `one statement per line (Fun does not use indentation)`
    relations
      seeAlso
        - pit.newline-is-not-a-statement
    examples
      -
        code `var a = 1;
var b = a
  + 2;
?. b;
`
        expect `3
`
      -
        code `if true then
  ?. 'ok';
end if
?. 'done';
`
        expect `ok
done
`

  -
    id syntax.comment
    type construct
    name Comments
    summary Both `#` and `//` start a line comment. `#* ... #` is a block comment; the next `#` closes it.
    level 0
    tags
      - core
      - syntax
    card `# line / // line / #* block #`
    intent
      - comment
      - 注释
    from
      js `// comment`
      py `# comment`
    examples
      -
        code `# a hash comment
// a slash comment
#* a block
   comment #
?. 1;
`
        expect `1
`

  -
    id syntax.var
    type construct
    name Variables
    summary Declare with `var name = expr;` or `var name;` (nil). There is no `let` or `const`; identifiers are case-insensitive.
    level 0
    tags
      - core
      - syntax
    card `var x = expr;`
    intent
      - declare a variable
      - constant
      - 变量
      - 声明
    from
      js `let x = 1; const y = 2;`
      py `x = 1`
      c `int x = 1;`
    relations
      seeAlso
        - sem.case-insensitive
        - syntax.assignment
    examples
      -
        code `var x = 1;
var y;
?. x;
?. y = nil;
`
        expect `1
True
`

  -
    id syntax.assignment
    type construct
    name Assignment and equality
    summary A statement `x = expr;` assigns; the same `=` inside an expression compares. `<>` and `!=` both mean not-equal. Compound assignment uses `+= -= *= &=`.
    level 0
    tags
      - core
      - syntax
    card `x = value; if a = b then ...`
    intent
      - assign
      - compare
      - equality
      - 赋值
      - 比较
    from
      js `x = 1; if (a === b)`
      py `x = 1; if a == b:`
      c `x = 1; if (a == b)`
    relations
      seeAlso
        - pit.double-equals
    examples
      -
        code `var x = 1;
x = x + 2;
?. x;
?. x = 3;
?. x <> 4;
`
        expect `3
True
True
`

  -
    id syntax.print
    type construct
    name Print and output
    summary The `?.` operator prints with a newline, `?,` prints with a space, and `?:` prints with a tab. All three accept any value.
    level 0
    tags
      - core
      - io
    card `?. value;`
    intent
      - print
      - output
      - log
      - 输出
      - 打印
    from
      js `console.log(value)`
      py `print(value)`
      c `printf("%v\n", value);`
    relations
      seeAlso
        - syntax.hello
        - builtin.tojson
    examples
      -
        code `?, 'a';
?: 'b';
?. 'c';
`
        expect `a b	c
`

  -
    id syntax.function
    type construct
    name Named functions
    summary A `fun name(params) ... end fun;` returns the value assigned to `result`; `return expr;` exits early. `result` is not reset on entry, so initialize it explicitly.
    level 0
    tags
      - core
      - function
    card `fun f(a, b) result = a + b; end fun;`
    intent
      - define a function
      - return a value
      - 函数
      - 返回值
    from
      js `function f(a, b) { return a + b; }`
      py `def f(a, b): return a + b`
      c `int f(int a, int b) { return a + b; }`
    relations
      seeAlso
        - sem.result
        - syntax.lambda
        - sem.named-args
    examples
      -
        code `fun add(a, b)
  result = a + b;
end fun;
?. add(2, 3);
`
        expect `5
`

  -
    id syntax.lambda
    type construct
    name Lambdas
    summary A lambda `a -> expr` takes one argument; `(a, b) -> expr` takes several. A braced body is a block that must assign `result`.
    level 0
    tags
      - core
      - function
    card `f = a -> a * 2;`
    intent
      - anonymous function
      - callback
      - lambda
      - 匿名函数
    from
      js `a => a * 2`
      py `lambda a: a * 2`
    relations
      seeAlso
        - idiom.pipeline
    examples
      -
        code `use 'lib-set.fun';
var f = a -> a * 2;
?. f(3);
var nums = [1, 2, 3];
?. (nums | map(a -> a + 1)).@toJson();
`
        expect `6
[2,3,4]
`

  -
    id syntax.if
    type construct
    name Conditionals
    summary The form `if c then ... elsif c2 then ... else ... end if;` uses Fun truthiness; use explicit comparisons for clarity.
    level 0
    tags
      - core
      - control
    card `if c then ... elsif c2 then ... else ... end if;`
    intent
      - if
      - condition
      - 条件
    from
      js `if (c) { } else { }`
      py `if c: ... else: ...`
    relations
      seeAlso
        - syntax.case
    examples
      -
        code `var n = 2;
if n = 1 then
  ?. 'one';
elsif n = 2 then
  ?. 'two';
else
  ?. 'other';
end if;
`
        expect `two
`

  -
    id syntax.case
    type construct
    name Case
    summary The form `case expr is when v do ... else ... end case;` matches values.
    level 0
    tags
      - core
      - control
    card `case x is when 1 do ... else ... end case;`
    intent
      - switch
      - case
      - 分支
    from
      js `switch (x) { case 1: ... }`
      py `match x: case 1: ...`
    examples
      -
        code `var x = 2;
case x is
  when 1 do ?. 'one';
  when 2 do ?. 'two';
  else ?. 'other';
end case;
`
        expect `two
`

  -
    id syntax.loop
    type construct
    name Loops
    summary Forms: `for i = a to b do ... end do;`, `for k: v in set do ... end do;`, `while c do ... end do;`, and `loop ... exit when c; ... end loop;`. `next when c;` skips.
    level 0
    tags
      - core
      - control
    card `for i = 1 to 3 do ... end do;`
    intent
      - loop
      - iterate
      - for
      - while
      - 循环
      - 遍历
    from
      js `for (let i = 0; i < n; i++) {}`
      py `for i in range(n):`
    relations
      seeAlso
        - syntax.collection
    examples
      -
        code `var total = 0;
for i = 1 to 3 do
  total += i;
end do;
?. total;
var m = 0;
loop
  m += 1;
  exit when m >= 2;
end loop;
?. m;
`
        expect `6
2
`

  -
    id syntax.try
    type construct
    name Errors
    summary The form `try ... except ... finally ... end try;` catches `raise` and runtime errors. `runtime.lastError()` exposes message, file, line and stack.
    level 0
    tags
      - core
      - error
    card `try ... except ... end try;`
    intent
      - error handling
      - exception
      - 异常
      - 错误处理
    from
      js `try { } catch (e) { }`
      py `try: ... except Exception as e: ...`
    relations
      seeAlso
        - module.runtime
    examples
      -
        code `try
  raise 'boom';
except
  ?. 'caught';
end try;
`
        expect `caught
`

  -
    id syntax.class
    type construct
    name Classes
    summary A `class Name(params) ... end class;` body runs as the constructor; `var` fields become members, `fun` declarations become methods, `this` is the instance and `base` the parent. Inherit with `class Child = Parent()`.
    level 0
    tags
      - core
      - object
    card `class C(x) var x = x; fun get() result = x; end fun; end class;`
    intent
      - class
      - object
      - constructor
      - 类
      - 对象
    from
      js `class C { constructor(x) { this.x = x; } }`
      py `class C: def __init__(self, x): self.x = x`
    relations
      seeAlso
        - syntax.operator
    examples
      -
        code `class Point(x, y)
  var x = x;
  var y = y;
  fun sum() result = x + y; end fun;
end class;
var p = Point(2, 3);
?. p.sum();
?. p.x;
`
        expect `5
2
`

  -
    id syntax.use
    type construct
    name Modules
    summary The statement `use 'lib-set.fun';` links a module by file name; `use 'x.fun' as ns;` namespaces it. Paths resolve relative to the script and the runtime `lib/` directory.
    level 0
    tags
      - core
      - module
    card `use 'lib-set.fun';`
    intent
      - import
      - module
      - library
      - 导入
      - 模块
    from
      js `import x from './x.js'`
      py `import x`
      c `#include "x.h"`
    relations
      partOf
        - tool.funcmd
    examples
      -
        code `use 'lib-set.fun';
var xs = [1, 2, 3];
?. (xs | map(a -> a * 2)).@toJson();
`
        expect `[2,4,6]
`

  -
    id syntax.collection
    type construct
    name Lists and maps
    summary A list literal `[1, 2, 3]` is a list. `new [k: v]` is a string-keyed map (called a set in Fun). Both support `@count`, `@has`, `@add`, and JSON conversion.
    level 0
    tags
      - core
      - data
    card `var xs = [1,2]; var m = new [a: 1];`
    intent
      - list
      - array
      - map
      - dictionary
      - set
      - 数组
      - 字典
      - 集合
    from
      js `[1, 2]; {a: 1}`
      py `[1, 2]; {'a': 1}`
      c `int a[2] = {1, 2};`
    relations
      seeAlso
        - sem.reference
        - idiom.accumulator
    examples
      -
        code `var xs = [1, 2, 3];
var m = new [name: 'Ada'];
?. xs.@count();
?. m.name;
?. m['name'];
xs.@add(4);
?. xs.@toJson();
`
        expect `3
Ada
Ada
[1,2,3,4]
`

  -
    id syntax.member
    type construct
    name Member access
    summary Forms `obj.key`, `obj['key']` and `obj.['1']` read members; a missing member compares equal to nil. Postfix `?` makes a member or its base optional: `x?.k?`.
    level 0
    tags
      - core
      - syntax
    card `obj.key / obj['key'] / a?.k?`
    intent
      - property
      - field
      - index
      - 成员
      - 索引
    from
      js `obj.key; obj['key']; a?.k`
      py `obj.key; obj['key']`
    relations
      seeAlso
        - sem.missing-is-nil
        - pit.optional-chain
    examples
      -
        code `var m = new [name: 'Ada'];
?. m.name;
?. m['name'];
?. m.missing = nil;
var none = nil;
?. none?.name? = nil;
`
        expect `Ada
Ada
True
True
`

  -
    id syntax.method
    type construct
    name Built-in methods
    summary Engine-provided methods use `@`: `x.@toJson()`, `s.@count()`, `m.@('group')`. Methods you write in a class are called without `@`.
    level 0
    tags
      - core
      - syntax
    card `value.@builtin(); obj.userMethod();`
    intent
      - built-in method
      - toJson
      - count
      - 内建方法
    from
      js `value.toString()`
      py `len(value)`
    relations
      seeAlso
        - builtin.tojson
        - sem.user-vs-builtin
    examples
      -
        code `var xs = [1, 2, 3];
?. xs.@count();
?. xs.@toJson();
`
        expect `3
[1,2,3]
`

  -
    id syntax.pipe
    type construct
    name Pipe
    summary The pipe `value | f` passes the value as the last argument of `f`. `map(f)` takes the list last, so it composes; `filter(list, f)` takes the list first, so call it directly.
    level 0
    tags
      - core
      - functional
    card `xs | map(f) | filter(p)`
    intent
      - pipeline
      - chain
      - 管道
    from
      js `xs.map(f).filter(p)`
      py `filter(p, map(f, xs))`
    relations
      seeAlso
        - idiom.pipeline
        - syntax.lambda
    examples
      -
        code `use 'lib-set.fun';
var xs = [1, 2, 3, 4];
var ys = xs | map(a -> a * 10);
?. ys.@toJson();
`
        expect `[10,20,30,40]
`

  -
    id syntax.string
    type construct
    name Strings
    summary Single, double and backtick quotes all delimit strings. Literals do not decode backslash escapes; call `.escape()` to decode `\n`, `\t`, etc., use `10.toChar()`, or use a multiline backtick string. `$name` interpolation is done by `.eval()`.
    level 0
    tags
      - core
      - text
    card `'a\nb'.escape() / backtick multiline`
    intent
      - string
      - escape
      - interpolation
      - 字符串
      - 转义
    from
      js `"a\nb"`
      py `"a\nb"`
    relations
      seeAlso
        - pit.backslash-escape
        - builtin.escape
    examples
      -
        code `var a = 'x\ny'.escape();
?. a.length();
var b = 'hello';
?. 'say $b'.eval();
var c = 'one' & 10.toChar() & 'two';
?. c;
`
        expect `3
say hello
one
two
`

  -
    id syntax.regex
    type construct
    name Regular expressions
    summary Regex literals are `/pattern/flags`, `%pattern%flags` or `$'pattern'flags`. Use `=~` / `!~` to test, `.match()` to extract, `.replace()` to rewrite.
    level 0
    tags
      - core
      - text
    card `s.match(/\d+/g); s.replace(/\d+/g, fn); s =~ /^a/`
    intent
      - regex
      - match
      - replace
      - 正则
    from
      js `s.match(/\d+/g)`
      py `re.findall(r'\d+', s)`
    relations
      seeAlso
        - pit.match-group
    examples
      -
        code `var s = 'a1b22';
?. s.match(/\d+/g).@toJson();
?. s.replace(/\d+/g, (m) -> '[' & m.@(0) & ']');
?. (s =~ /^a/) <> nil;
`
        expect `["1","22"]
a[1]b[22]
True
`

  -
    id syntax.json
    type construct
    name JSON
    summary The built-in `value.@toJson()` emits JSON; `value.@toJson(json: true)` quotes keys. Parse with `text.getJson(json: true)`. `text.getJson(fd: true)` parses FD.
    level 0
    tags
      - core
      - data
    card `s.getJson(json: true); v.@toJson(json: true);`
    intent
      - json parse
      - json stringify
      - JSON
      - 解析JSON
    from
      js `JSON.parse(s); JSON.stringify(v)`
      py `json.loads(s); json.dumps(v)`
    relations
      seeAlso
        - syntax.fd
        - module.lib-json
    examples
      -
        code `var m = '{"a": 1, "b": [2, 3]}'.getJson(json: true);
?. m.a;
?. m.b[1];
?. m.@toJson(json: true);
`
        expect `1
3
{"a":1,"b":[2,3]}
`

  -
    id syntax.fd
    type construct
    name FD data
    summary FD is Fun's indentation data notation: `key value` lines, `- item` lists, no braces. `text.getJson(fd: true)` parses it and `value.@toJson(fd: true)` emits it.
    level 0
    tags
      - core
      - data
    card `s.getJson(fd: true); v.@toJson(fd: true);`
    intent
      - fd
      - configuration
      - data format
      - 配置
      - 数据格式
    from
      js `YAML-like nested objects`
      py `dict / list`
    relations
      seeAlso
        - module.lib-fd
        - syntax.json
    examples
      -
        code `var s = 'name Ada' & 10.toChar() & 'tags' & 10.toChar() & '  - math' & 10.toChar() & '  - code';
var m = s.getJson(fd: true);
?. m.name;
?. m.tags.@count();
`
        expect `Ada
2
`

  # ---------------------------------------------------------------------------
  # Semantics that LLMs routinely get wrong
  # ---------------------------------------------------------------------------
  -
    id sem.missing-is-nil
    type semantic
    name Missing values compare to nil
    summary Reading a missing member, key or index yields a value that compares equal to nil. This makes `if x = nil then x = init; end if` safe.
    level 0
    tags
      - semantic
      - nil
    card `missing = nil -> True`
    intent
      - undefined
      - null
      - missing
      - 未定义
      - 空值
    from
      js `undefined == null`
      py `None`
    relations
      seeAlso
        - pit.missing-key-accumulate
        - sem.nil-arithmetic
    examples
      -
        code `var m = new [];
?. m.nope = nil;
?. m['nope'] = nil;
?. m[0] = nil;
`
        expect `True
True
True
`

  -
    id sem.nil-arithmetic
    type semantic
    name nil acts as zero in arithmetic
    summary A nil operand in `+ - * / div mod` is treated as 0, and as '' for strings. `x += 1` therefore works on a fresh key. The flip side is that a missing value also compares equal to 0.
    level 0
    tags
      - semantic
      - nil
      - pitfall
    card `nil + 1 -> 1; x += 1 works on a fresh key`
    intent
      - nil arithmetic
      - accumulator
      - 空值运算
      - 累加
    from
      js `undefined + 1 -> NaN`
      py `None + 1 -> TypeError`
    relations
      fixedBy
        - idiom.accumulator
      seeAlso
        - sem.or-value
    examples
      -
        code `var m = new [];
m.k += 1;
?. m.k;
var z;
?. z + 1;
?. m.@has('k');
?. m.@has('no');
`
        expect `1
1
True
False
`

  -
    id sem.or-value
    type semantic
    name or/and return values
    summary Operators `or` and `and` return one of their operands, Lua style: `nil or 5` is 5, `7 or 5` is 7. This powers default values.
    level 0
    tags
      - semantic
    card `x = x or default;`
    intent
      - default value
      - or
      - 默认值
    from
      js `x ?? default`
      py `x if x is not None else default`
    relations
      seeAlso
        - idiom.default
        - sem.nil-arithmetic
    examples
      -
        code `?. (nil or 5);
?. (7 or 5);
?. (nil and 5) = nil;
`
        expect `5
7
True
`

  -
    id sem.result
    type semantic
    name result is not reset
    summary Each function has one `result` slot. It is not cleared on entry, so a call at the same stack depth can see the previous value. Always initialize `result`.
    level 0
    tags
      - semantic
      - pitfall
    card `fun f() result = 0; ... end fun;`
    intent
      - return value
      - result
      - 返回值
    from
      js `return undefined by default`
      py `return None by default`
    relations
      seeAlso
        - syntax.function
    examples
      -
        code `fun f(n)
  if n > 0 then result = n; end if;
end fun;
?. f(1);
?. f(0);
fun g(n)
  result = 0;
  if n > 0 then result = n; end if;
end fun;
?. g(1);
?. g(0);
`
        expect `1
1
1
0
`

  -
    id sem.case-insensitive
    type semantic
    name Identifiers are case-insensitive
    summary Variables, functions, members and built-in method names all fold case. Avoid local names that differ from another symbol only by case.
    level 0
    tags
      - semantic
      - pitfall
    card `Foo = foo; o.NAME = o.name;`
    intent
      - case sensitivity
      - 大小写
    from
      js `case-sensitive`
      py `case-sensitive`
    relations
      seeAlso
        - syntax.var
    examples
      -
        code `var Foo = 1;
?. foo;
var m = new [name: 'Ada'];
?. m.NAME;
?. 'Hi'.UPPER();
`
        expect `1
Ada
HI
`

  -
    id sem.named-args
    type semantic
    name Named arguments
    summary Call sites may name arguments: `f(b: 2, a: 1)`. Missing arguments are nil, so defaults are written as `if p = nil then p = default; end if`.
    level 0
    tags
      - semantic
      - function
    card `f(b: 2, a: 1)`
    intent
      - named arguments
      - default argument
      - 命名参数
      - 默认参数
    from
      js `f({a: 1, b: 2})`
      py `f(a=1, b=2)`
    relations
      seeAlso
        - syntax.function
    examples
      -
        code `fun greet(name, punct)
  if punct = nil then punct = '!'; end if;
  result = 'Hi ' & name & punct;
end fun;
?. greet('Ada');
?. greet(punct: '?', name: 'Bob');
`
        expect `Hi Ada!
Hi Bob?
`

  -
    id sem.type
    type semantic
    name Value types
    summary The method `.type()` returns 0 nil, 3 int, 5 real, 6 currency, 7 time, 8 string, 11 bool, -1 other. Integers are 32-bit unless explicitly 64-bit.
    level 1
    tags
      - semantic
      - type
    card `x.type() -> 0/3/5/6/7/8/11/-1`
    intent
      - type
      - typeof
      - 类型
    from
      js `typeof x`
      py `type(x)`
    relations
      seeAlso
        - module.lib-type
    examples
      -
        code `var n = 1;
var s = 'x';
var z;
var b = true;
?. n.type();
?. s.type();
?. z.type();
?. b.type();
`
        expect `3
8
0
11
`

  -
    id sem.reference
    type semantic
    name Maps and lists are references
    summary Assigning a map or list copies the reference. Mutating one alias is visible through the other; use `@clone()` for an independent copy.
    level 1
    tags
      - semantic
      - data
    card `var b = a; b.k = 1; # a.k is 1; use a.@clone()`
    intent
      - copy
      - reference
      - clone
      - 拷贝
      - 引用
    from
      js `objects are references`
      py `lists/dicts are references`
    relations
      seeAlso
        - syntax.collection
    examples
      -
        code `use 'lib-set.fun';
var a = [x: 1];
var b = a;
b.x = 2;
?. a.x;
var c = a.@clone();
c.x = 3;
?. a.x;
?. c.x;
`
        expect `2
2
3
`

  # ---------------------------------------------------------------------------
  # Idioms
  # ---------------------------------------------------------------------------
  -
    id idiom.default
    type idiom
    name Default value
    summary Use `or` to supply a default for nil or false. `x = x or default;`.
    level 0
    tags
      - idiom
    card `name = name or 'anonymous';`
    intent
      - default value
      - fallback
      - 默认值
      - 兜底
    from
      js `name = name || 'anonymous'`
      py `name = name or 'anonymous'`
    relations
      requires
        - sem.or-value
    examples
      -
        code `fun greet(name)
  name = name or 'anonymous';
  result = 'Hi ' & name;
end fun;
?. greet(nil);
?. greet('Ada');
`
        expect `Hi anonymous
Hi Ada
`

  -
    id idiom.accumulator
    type idiom
    name Safe accumulator
    summary Seed a counter explicitly when you want the intent to be obvious across builds: `m.k = (m.k or 0) + 1;`. On 9.5.7, `m.k += 1` also yields 1.
    level 0
    tags
      - idiom
      - pitfall
    card `m.k = (m.k or 0) + 1;`
    intent
      - count
      - counter
      - accumulate
      - 计数
      - 累加
    from
      js `m[k] = (m[k] || 0) + 1`
      py `m[k] = m.get(k, 0) + 1`
    relations
      requires
        - sem.nil-arithmetic
    examples
      -
        code `var m = new [];
m.k = (m.k or 0) + 1;
m.k = (m.k or 0) + 1;
?. m.k;
`
        expect `2
`

  -
    id idiom.pipeline
    type idiom
    name Data pipeline
    summary The pipeline `xs | map(f)` reads left to right. Add `use 'lib-set.fun';` first. `map` takes the list last and composes; `filter` takes the list first.
    level 0
    tags
      - idiom
      - functional
    card `xs | map(f)`
    intent
      - transform list
      - pipeline
      - 列表处理
      - 管道
    from
      js `xs.map(f).filter(p)`
      py `[...]`
    relations
      requires
        - syntax.use
      seeAlso
        - syntax.pipe
    examples
      -
        code `use 'lib-set.fun';
var xs = [1, 2, 3, 4];
?. (xs | map(a -> a * a)).@toJson();
?. filter(xs, a -> a > 2).@toJson();
`
        expect `[1,4,9,16]
[3,4]
`

  -
    id idiom.closure
    type idiom
    name Closure counter
    summary A function value captures its defining scope. Capture an argument to build a specialized function without a class.
    level 1
    tags
      - idiom
      - function
    card `fun adder(n) result = a -> a + n; end fun;`
    intent
      - closure
      - partial application
      - 闭包
    from
      js `let n = 0; return () => ++n`
      py `def counter(): n = 0; ...`
    relations
      seeAlso
        - syntax.lambda
    examples
      -
        code `fun adder(n)
  result = a -> a + n;
end fun;
var add2 = adder(2);
?. add2(3);
?. add2(10);
`
        expect `5
12
`

  -
    id idiom.json-roundtrip
    type idiom
    name JSON round trip
    summary Parse with `.getJson(json: true)`, inspect with member access, emit with `.@toJson(json: true)`.
    level 0
    tags
      - idiom
      - json
    card `var m = s.getJson(json: true); ...; m.@toJson(json: true)`
    intent
      - parse json
      - api response
      - 解析JSON
    from
      js JSON.parse / JSON.stringify
      py json.loads / json.dumps
    relations
      requires
        - syntax.json
    examples
      -
        code `var s = '{"users": [{"name": "Ada"}]}';
var m = s.getJson(json: true);
?. m.users[0].name;
m.users[0].active = true;
?. m.@toJson(json: true);
`
        expect `Ada
{"users":[{"name":"Ada","active":true}]}
`

  -
    id idiom.file-io
    type idiom
    name Read and write files
    summary The built-in `'path'.load()` reads a whole file; `'path'.save(text)` writes one. For directories, atomic writes and walking use `use 'fs.fun';`.
    level 1
    tags
      - idiom
      - io
    card `var s = 'in.txt'.load(); 'out.txt'.save(s);`
    intent
      - read file
      - write file
      - 读文件
      - 写文件
    from
      js `fs.readFileSync(p, 'utf8')`
      py `open(p).read()`
    relations
      seeAlso
        - module.fs
    examples
      -
        code `use 'fs.fun';
var p = fs.tempFile('fun-ontology-');
p.save('hello');
?. p.load();
fs.removeAll(p);
`
        expect `hello
`

  -
    id idiom.cli
    type idiom
    name Command-line arguments
    summary The expression `i.arg()` reads argv by position; `Argv()` (from `lib-cmdline`) returns the list. `use 'cli.fun';` gives flags, subcommands and help.
    level 1
    tags
      - idiom
      - cli
    card `var first = 2.arg();`
    intent
      - cli
      - argv
      - arguments
      - 命令行
    from
      js `process.argv`
      py `sys.argv`
    relations
      seeAlso
        - module.cli
    examples
      -
        code `?. 0.arg().length() > 0;
`
        expect `True
`

  -
    id idiom.ffi
    type idiom
    name Call native code
    summary The call `LibC().getapi(name, signature)` or `'libname'.getapi(...)` binds a native function. The signature is `argtypes:rettype`, e.g. `':i'` for no args returning int.
    level 2
    tags
      - idiom
      - native
    card `var f = LibC().getapi('getpid', ':i'); f();`
    intent
      - ffi
      - native call
      - foreign function
      - 调用C
    from
      c `#include <unistd.h>; getpid();`
      js `native addon`
    relations
      requires
        - module.lib-host
      seeAlso
        - module.lib-cwinapi
        - module.lib-cstruct
    examples
      -
        code `use 'lib-host.fun';
var getpid = LibC().getapi('getpid', ':i');
?. getpid() > 0;
`
        expect `True
`

  # ---------------------------------------------------------------------------
  # Pitfalls: habits imported from other languages
  # ---------------------------------------------------------------------------
  -
    id pit.double-equals
    type pitfall
    name There is no ==
    summary Use `=` for equality inside an expression, and `<>` or `!=` for inequality. `==` is not Fun.
    level 0
    tags
      - pitfall
      - syntax
    card `if a = b then ...; if a <> b then ...;`
    intent
      - equality
      - not equal
      - 等于
    from
      js `===`
      py `==`
      c `==`
    relations
      seeAlso
        - syntax.assignment
    examples
      -
        code `?. (1 = 1);
?. (1 <> 2);
`
        expect `True
True
`

  -
    id pit.newline-is-not-a-statement
    type pitfall
    name Newlines do not end statements
    summary A newline is whitespace. Put `;` between statements; a continuation line can silently join the previous expression.
    level 0
    tags
      - pitfall
      - syntax
    card `a = 1; b = 2;`
    intent
      - newline
      - automatic semicolon
      - 换行
    from
      js `automatic semicolon insertion`
      py `indentation ends statements`
    relations
      seeAlso
        - syntax.statement
    examples
      -
        code `var a = 1
  + 2;
?. a;
`
        expect `3
`

  -
    id pit.backslash-escape
    type pitfall
    name Literals do not decode backslash escapes
    summary The literal `'\n'` is a backslash followed by `n`, not a newline. Call `.escape()` to decode it, or use `10.toChar()` or a multiline backtick string.
    level 0
    tags
      - pitfall
      - text
    card `'a\nb'.escape()`
    intent
      - newline
      - escape
      - 换行
      - 转义
    from
      js `"a\nb"`
      py `"a\nb"`
    relations
      seeAlso
        - syntax.string
        - builtin.escape
    examples
      -
        code `?. 'a\nb'.length();
?. 'a\nb'.escape().length();
?. ('a' & 10.toChar() & 'b').length();
`
        expect `4
3
3
`

  -
    id pit.optional-chain
    type pitfall
    name Optional chaining is limited
    summary The form `x?.k?` makes the base and the member optional. It does not make a following call optional, and `f()?.x` is not the JS form; assign to a variable first.
    level 1
    tags
      - pitfall
      - syntax
    card 'a?.k? only'
    intent
      - optional chaining
      - null safe
      - 可选链
    from
      js `a?.k?.()`
    relations
      seeAlso
        - syntax.member
    examples
      -
        code `fun pick(o, k) result = o?.k?; end fun;
?. pick(new [k: 7], 'k');
?. pick(nil, 'k') = nil;
`
        expect `7
True
`

  -
    id pit.match-group
    type pitfall
    name Regex match group access
    summary In a match object, `m.@(0)` is the whole match and `m.@('name')` a named group; `m.@@()` is also the whole match. `m.@()` with no argument is not valid.
    level 1
    tags
      - pitfall
      - text
    card `m.@(0); m.@('group'); m.@@()`
    intent
      - regex group
      - capture
      - 正则分组
    from
      js `m[0]`
      py `m.group(0)`
    relations
      seeAlso
        - syntax.regex
    examples
      -
        code `var m = 'a12'.match(/(\d+)/);
?. m.@(0);
?. m.@(1);
`
        expect `12
12
`

  -
    id pit.missing-key-accumulate
    type pitfall
    name A missing value also equals zero
    summary A missing value compares equal to nil and to 0, so `if x = 0` cannot tell "absent" from "zero". Use `.@has(key)` when presence matters.
    level 0
    tags
      - pitfall
      - data
    card `m.@has('k')`
    intent
      - presence
      - missing key
      - 键是否存在
    from
      js `Object.hasOwn(m, k)`
      py `k in m`
    relations
      seeAlso
        - sem.missing-is-nil
    examples
      -
        code `var m = new [];
?. m.k = nil;
?. m.k = 0;
?. m.@has('k');
m.k = 0;
?. m.@has('k');
`
        expect `True
True
False
True
`

  -
    id pit.array-vs-map
    type pitfall
    name [] is a list, new [] is a map
    summary A list literal `[1, 2]` is ordered; `new [a: 1]` is a string-keyed map. Do not use `{}` for either.
    level 0
    tags
      - pitfall
      - data
    card `[1,2,3] / new [k: v]`
    intent
      - array
      - dictionary
      - 数组
      - 字典
    from
      js `[] / {}`
      py `[] / {}`
    relations
      seeAlso
        - syntax.collection
    examples
      -
        code `var xs = [10, 20];
var m = new [a: 10];
?. xs[1];
?. m.a;
`
        expect `20
10
`

  -
    id pit.return-keyword
    type pitfall
    name result vs return
    summary Inside `fun`, assigning `result` sets the return value; `return expr;` returns immediately. A bare `return;` returns the current `result`, which may be stale.
    level 0
    tags
      - pitfall
      - function
    card 'result = expr; or return expr;'
    intent
      - return
      - 返回
    from
      js `return x`
      py `return x`
    relations
      seeAlso
        - sem.result
    examples
      -
        code `fun f()
  result = 1;
  return 2;
  result = 3;
end fun;
?. f();
`
        expect `2
`

  # ---------------------------------------------------------------------------
  # Tools, modules and platform
  # ---------------------------------------------------------------------------
  -
    id tool.funcmd
    type tool
    name The fun command
    summary The command `fun file.fun` runs a script; `fun test` runs a package's tests; `fun pack` builds one executable; `fun package init` creates a manifest.
    level 0
    tags
      - tool
      - cli
    card `fun hello.fun / fun test / fun pack`
    intent
      - run
      - test
      - build
      - 运行
      - 测试
      - 打包
    from
      js `node hello.js`
      py `python hello.py`
    relations
      seeAlso
        - tool.package
        - tool.test
    examples
      -
        code `?. 'Use: fun hello.fun';
`
        expect `Use: fun hello.fun
`
        runnable true

  -
    id tool.test
    type tool
    name Tests
    summary Test files are `*_test.fun`; import `test.fun` and call `test('name', { assert.equal(a, b); });`. `fun test` runs each file in a child process.
    level 1
    tags
      - tool
      - test
    card `use 'test.fun'; test('name', { assert.equal(a, b); });`
    intent
      - unit test
      - assertion
      - 单元测试
    from
      js `test('name', () => expect(a).toBe(b))`
      py `def test_name(): assert a == b`
    relations
      requires
        - tool.package
    examples
      -
        code `?. 'Write this in a *_test.fun file, then run: fun test';
`
        expect `Write this in a *_test.fun file, then run: fun test
`
        runnable true

  -
    id tool.package
    type tool
    name Packages
    summary A project has a `package.fun` manifest. `fun package init/tidy/add/remove` creates and maintains it; `fun run` runs the manifest bin.
    level 1
    tags
      - tool
      - package
    card `fun package init myapp && fun run`
    intent
      - package
