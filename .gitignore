# ===========================================================================
# Fun language - .gitignore
# Generated build artifacts and editor files are NOT tracked.
# Keep source (.pas/.inc/.dpr/.fun/.ebnf/.y/.l) and docs only.
# ===========================================================================

# ---- Pascal / Delphi / Free Pascal build artifacts ----
*.dcu
*.ppu
*.o
*.obj
*.a
*.so
*.dylib
*.s
*.map
*.drc
*.pdb
*.stat
*.exe
*.dll
*.dylib
*.or

# The DLL license document is source text, not a binary - keep it tracked.
!LICENSE.dll

# Delphi / CodeGear IDE project/editor files
*.dof
*.dsk
*.cfg
*.local
*.identcache
*.projdata
*.ddp
*.res

# dcc32 reads <project>.cfg automatically (the Delphi make-*.bat builds rely on
# it for their -D defines), so this one is a source file, not an IDE artifact.
!src/prj/fun/funcmd.cfg

# funcmd.dpr compiles its icon/version resource with {$R *.res}; the build
# fails outright without it, so this one .res is a source asset, not an artifact.
!src/prj/fun/funcmd.res

# Native Linux console build of funcmd.dpr (no extension, unlike the .exe)
src/prj/fun/funcmd
src/prj/fun/funcmd-safe
src/prj/fun/units/
src/prj/fun/units-safe/
src/prj/fun/.ffi/

# Convenience copy of the Linux build in the runtime folder (make-linux-x86_64.sh),
# plus any scratch copies kept alongside it while comparing builds.
/fun/funcmd
/fun/funcmd-safe
/fun/funcmd[0-9]*

# Local transcripts from running the interactive demos (scratch output)
/fun/demo/*.fun.log

# Generated Yacc/Lex output (keep the .y / .l / .ebnf sources)
src/parse/dyl/yyparse.cod
src/parse/dyl/yylex.cod
src/parse/bnf/lex.lst
src/parse/bnf/yacc.lst

# Backup / temp files (matches src/del_~files.bat conventions)
*.gz
*.bak
*.tmp
*~
~*.*
*.~*

# lib-asm-pro embeds this StdLib table at compile time (not a backup tarball).
!fun/lib/*.gz

# ---- Prebuilt third-party binaries (build from source instead) ----
# Uncomment to ignore shipped binaries:
# fun/*.exe
# fun/*.dll

# macOS cross-build outputs (make-darwin.sh) and its scratch tools dir
fun/funcmd-darwin-*
src/prj/fun/.darwin-tools/
src/prj/fun/libtcc.dylib

# Linux aarch64 cross-build output (make-linux-aarch64.sh)
fun/funcmd-linux-*

# Vendored PCRE C source uploaded under src/3rd (build from source; not tracked)
src/3rd/pcre-8/

# Vendored Tiny C Compiler source (builds libtcc.so for lib-tcc.fun; not tracked)
src/3rd/tcc/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Local article drafts (own git repo, backed up to /data/git/funlang/fun-art) ----
art/

# fun/test/ is tracked: the Linux/Windows regression runner, its expected
# snapshots and the FFI/tool helpers live there. Build outputs (*.so, *.o, ...)
# are still ignored by the rules above.
