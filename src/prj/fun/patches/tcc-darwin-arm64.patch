 # ifndef HAVE_SELINUX
+#  ifndef TCC_USE_MACOS_JIT
     addr_t start, end;
 #  ifndef PAGESIZE
 #   define PAGESIZE 4096
@@ -294,9 +342,14 @@
     end = (end + PAGESIZE - 1) & ~(PAGESIZE - 1);
     if (mprotect((void *)start, end - start, PROT_READ | PROT_WRITE | PROT_EXEC))
         tcc_error("mprotect failed: did you mean to configure --with-selinux?");
+#  endif
 # endif
 # if defined TCC_TARGET_ARM || defined TCC_TARGET_ARM64
+#  ifdef TCC_USE_MACOS_JIT
+    __builtin___clear_cache((char *)ptr, (char *)ptr + length);
+#  else
     __clear_cache(ptr, (char *)ptr + length);
+#  endif
 # endif
 #endif
 }
@@ -703,6 +756,27 @@
 
 static int rt_get_caller_pc(addr_t *paddr, ucontext_t *uc, int level)
 {
+#if defined(__APPLE__)
+    if (level < 0)
+        return -1;
+    else if (level == 0) {
+        *paddr = (addr_t)uc->uc_mcontext->__ss.__pc;
+        return 0;
+    }
+    else {
+        addr_t *fp = (addr_t *)(addr_t)uc->uc_mcontext->__ss.__fp;
+        int i;
+        for (i = 1; i < level; i++) {
+            if (!fp || (addr_t)fp < 0x1000)
+                return -1;
+            fp = (addr_t *)fp[0];
+        }
+        if (!fp)
+            return -1;
+        *paddr = (addr_t)fp[1];
+        return 0;
+    }
+#else
     if (level < 0)
         return -1;
     else if (level == 0) {
@@ -717,6 +791,7 @@
         *paddr = fp[1];
         return 0;
     }
+#endif
 }
 
