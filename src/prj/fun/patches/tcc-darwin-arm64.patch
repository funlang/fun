     for (i = 0; i < s1->nb_runtime_mem; ++i) {
-#ifdef HAVE_SELINUX
+#if defined(TCC_USE_MACOS_JIT)
+        unsigned size = (unsigned)(addr_t)s1->runtime_mem[i++];
+        munmap(s1->runtime_mem[i], size);
+#elif defined(HAVE_SELINUX)
         unsigned size = (unsigned)(addr_t)s1->runtime_mem[i++];
         munmap(s1->runtime_mem[i++], size);
         munmap(s1->runtime_mem[i], size);
@@ -285,6 +332,7 @@
 #else
