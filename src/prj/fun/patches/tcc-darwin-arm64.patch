--- a/tccrun.c
+++ b/tccrun.c
@@ -27,6 +27,14 @@
 # include <sys/mman.h>
 #endif
 
+#if defined(__APPLE__) && defined(__aarch64__)
+# include <dlfcn.h>
+# ifndef MAP_JIT
+#  define MAP_JIT 0x0800
+# endif
+# define TCC_USE_MACOS_JIT 1
+#endif
+
 #ifdef CONFIG_TCC_BACKTRACE
 # ifndef _WIN32
 #  include <signal.h>
@@ -52,6 +60,31 @@
 static void win64_del_function_table(void *);
 #endif
 
+#ifdef TCC_USE_MACOS_JIT
+/* Apple Silicon uses MAP_JIT instead of RWX pages. Writes are only allowed
+   while the calling thread has JIT write protection disabled. The symbol is
+   resolved at run time so the same code still links against older SDKs. */
+static void tcc_macos_jit_write_protect(int enabled)
+{
+    typedef void (*fn_t)(int);
+    static fn_t fn;
+    static int initialized;
+    if (!initialized) {
+        fn = (fn_t)dlsym(RTLD_DEFAULT, "pthread_jit_write_protect_np");
+        initialized = 1;
+    }
+    if (fn)
+        fn(enabled);
+}
+
+static void *tcc_macos_jit_alloc(unsigned long size)
+{
+    void *p = mmap(NULL, size, PROT_READ | PROT_WRITE | PROT_EXEC,
+                   MAP_PRIVATE | MAP_ANON | MAP_JIT, -1, 0);
+    return p == MAP_FAILED ? NULL : p;
+}
+#endif
+
 /* ------------------------------------------------------------- */
 /* Do all relocations (needed before using tcc_get_symbol())
    Returns -1 on error. */
@@ -86,9 +119,20 @@
     ptr_diff = (char*)prx - (char*)ptr;
 }
 #else
+# ifdef TCC_USE_MACOS_JIT
+    ptr = tcc_macos_jit_alloc(size);
+    if (!ptr)
+        tcc_error("tccrun: could not map JIT memory");
+    tcc_macos_jit_write_protect(0);
+# else
     ptr = tcc_malloc(size);
+# endif
 #endif
     tcc_relocate_ex(s1, ptr, ptr_diff); /* no more errors expected */
+#ifdef TCC_USE_MACOS_JIT
+    tcc_macos_jit_write_protect(1);
+    dynarray_add(&s1->runtime_mem, &s1->nb_runtime_mem, (void*)(addr_t)size);
+#endif
     dynarray_add(&s1->runtime_mem, &s1->nb_runtime_mem, ptr);
     return 0;
 }
@@ -98,7 +142,10 @@
