
########################################
# assign
########################################
#   v  = expression;
#   v += expression;
#   v -= expression;
#   v *= expression;
#   v &= expression;
########################################

var a = 1; ?. a = 1;
a += 2;    ?. a = 3;
a -= 1;    ?. a = 2;
a *= 2;    ?. a = 4;
a &= 5;    ?. a = '45';
