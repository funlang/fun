
########################################
# set-clone
########################################
#   new [...]
########################################
#   s.@clone()
########################################

var s1 = new [1, 2, 3];
s1.@each((i){?,i}); ?. null;

var s2 = s1.@clone();
s2.@each((i){?,i}); ?. null;

s1[0] = 11;
s2[1] = 22;
s1.@each((i){?,i}); ?. null;
s2.@each((i){?,i}); ?. null;
