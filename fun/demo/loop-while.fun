
########################################
# loop-while
########################################
#   while expression loop
#     cmds
#   end loop;
########################################

var i = 1;

while i <= 9 loop
  ? i;
  i += 1;
end loop;
?. '..DONE';

i = 9;

while i > 0 do
  ? i;
  i -= 1;
end do;
?. '..DONE';

########################################
# 1. while ... "loop" -> while ... "do"
#    end       "loop" -> end       "do"
########################################
