#!kvd:=
# asm-list-a64.fd -- AArch64 instruction templates for lib-asm-a64.fun.
#
# Format is the same kvd map as asm-list.fd (one key=value per line), so it is
# built by the same tool:
#   src/prj/fun/funcmd fun/lib/tools/make-asm-list.fun \
#       fun/lib/asm-list-a64.fd
# (sort by line -> prefix dedup -> asm-list-a64.fd2 -> .fd2.gz, which
# lib-asm-a64.fun embeds at parse time).
#
# key   = "<mnemonic> <op-shape>,..."   e.g. add x,x,#
# value = "<8 hex base word>|<slot>..."  e.g. "91000000|r0@0|r1@5|q2"
# Values are double-quoted so the FD reader keeps them as strings (an unquoted
# value starting with a hex digit is greedily parsed as a number).
# See lib-asm-a64.fun for the full slot grammar and the operand-shape list.
# ---------------------------------------------------------------- move wide
# ---------------------------------------------------------------- move (reg)
# ------------------------------------------------------- add/sub (immediate)
# q<i> = imm12 at bits 21..10 with an automatic lsl#12 split for values>=4096.
# ------------------------------------------------ add/sub (shifted register)
# ---------------------------------------------- logical (shifted register)
# ---------------------------------------------------- logical (immediate)
# L<i> = N:immr:imms (bitmask immediate) computed by _a64_logical.
# ------------------------------------------------------ conditional select
# ---------------------------------------------------- loads / stores (imm)
# register offset: [x+x] is S=0, [x+xs] sets the S bit (shift must be log2(size))
# --------------------------------------------------------------- pair load
# ----------------------------------------------------------------- branch
# @sum1ton: leaf function, x0 = n in, sum(1..n) in x0 out. Encoded from
#   mov x1, x0 / mov x0, #0 / loop: add x0,x0,x1 / subs x1,x1,#1 / b.ne loop / ret
# (verified byte-for-byte against the keystone/gas encoding of that sequence).
# shifted-register variants (logical + 32-bit add/sub), added from the
# randomized differential in D26 validation
# remaining halfword/byte memory forms
